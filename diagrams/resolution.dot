digraph G {
 graph [rankdir=LR, bgcolor="transparent", pad="0.2", nodesep="0.45", ranksep="0.65", fontname="Arial", fontsize=18, fontcolor="#263d46"];
 node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#a9b6b6", penwidth=1.5, fontname="Arial", fontsize=18, fontcolor="#142d39", margin="0.22,0.18"];
 edge [color="#78908f", penwidth=1.8, arrowsize=0.75, fontname="Arial", fontsize=14, fontcolor="#536b72"];

subgraph cluster_worker {
 label="WORKER SANDBOX"; color="#167d76"; style="rounded"; margin=24;
 load [label="library() / import\nmissing dependency"];
 live [label="Same live runtime\nresume original operation", fillcolor="#d9eee9", color="#167d76"];
}
server [label="Trusted preparation owner\nvalidate + retain"];
resolver [label="ir / uv / DuckDB\nprepare outside sandbox"];
load -> server [label="request"];
server -> resolver [label="prepare"];
resolver -> live [label="activate"];

}
