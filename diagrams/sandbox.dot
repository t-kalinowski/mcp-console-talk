digraph G {
 graph [rankdir=LR, bgcolor="transparent", pad="0.2", nodesep="0.45", ranksep="0.65", fontname="Arial", fontsize=18, fontcolor="#263d46"];
 node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#a9b6b6", penwidth=1.5, fontname="Arial", fontsize=18, fontcolor="#142d39", margin="0.22,0.18"];
 edge [color="#78908f", penwidth=1.8, arrowsize=0.75, fontname="Arial", fontsize=14, fontcolor="#536b72"];

subgraph cluster_sandbox {
 label="DEFAULT NATIVE WORKER SANDBOX"; color="#167d76"; style="rounded"; margin=25; fontsize=20;
 worker [label="R / Python / SQL"];
 scratch [label="Private temporary storage", fillcolor="#d9eee9", color="#167d76"];
 worker -> scratch [label="read + write"];
}
host [label="Host files"];
net [label="Direct network", color="#b56844", fillcolor="#f8e9df"];
host -> worker [label="read"];
worker -> net [label="denied", style=dashed, color="#b56844", arrowhead=tee];

}
