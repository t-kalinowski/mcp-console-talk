digraph G {
 graph [rankdir=LR, bgcolor="transparent", pad="0.2", nodesep="0.45", ranksep="0.65", fontname="Arial", fontsize=18, fontcolor="#263d46"];
 node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#a9b6b6", penwidth=1.5, fontname="Arial", fontsize=18, fontcolor="#142d39", margin="0.22,0.18"];
 edge [color="#78908f", penwidth=1.8, arrowsize=0.75, fontname="Arial", fontsize=14, fontcolor="#536b72"];

node [fontsize=22];
subgraph cluster_local {
 label="CONTROLLER"; style="rounded"; color="#a9b6b6"; margin=22;
 server [label="MCP server"];
 records [label="Local recordings", fillcolor="#d9eee9", color="#167d76"];
 server -> records;
}
ssh [label="OpenSSH"];
subgraph cluster_remote {
 label="EXECUTION HOST"; style="rounded"; color="#167d76"; margin=22;
 remote [label="Relay + worker"];
 deps [label="Remote resolvers"];
 data [label="Data + live state"];
 remote -> data;
 deps -> remote [style=dashed];
}
server -> ssh -> remote [label="transport"];

}
