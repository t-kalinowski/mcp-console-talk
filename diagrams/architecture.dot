digraph G {
 graph [rankdir=LR, bgcolor="transparent", pad="0.2", nodesep="0.45", ranksep="0.65", fontname="Arial", fontsize=18, fontcolor="#263d46"];
 node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#a9b6b6", penwidth=1.5, fontname="Arial", fontsize=18, fontcolor="#142d39", margin="0.22,0.18"];
 edge [color="#78908f", penwidth=1.8, arrowsize=0.75, fontname="Arial", fontsize=14, fontcolor="#536b72"];

node [fontsize=23];
client [label="MCP client"];
server [label="Rust server\nsession + records", fillcolor="#d9eee9", color="#167d76"];
runner [label="External native runner\npolicy + supervision"];
subgraph cluster_sandbox {
 label="SANDBOXED PROCESSES"; color="#167d76"; style="rounded"; margin=24;
 relay [label="Relay\ncode / streams"];
 worker [label="Worker\nR · Python · SQL"];
 relay -> worker [label="sideband\n+ stdio"];
}
resolver [label="ir / uv resolvers\ntrusted host process"];
client -> server [label="MCP stdio"];
server -> runner [label="launch"];
runner -> relay;
server -> resolver [label="prepare", style=dashed];

}
